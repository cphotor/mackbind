# udev rule for mackbind
#
# Install:
#   sudo install -m644 packaging/99-mackbind.rules /etc/udev/rules.d/99-mackbind.rules
#   sudo usermod -aG input "$USER"
#   sudo udevadm control --reload && sudo udevadm trigger
#   # Log out and back in (or reboot) so the new group membership takes effect
#
# ── Why this is needed ────────────────────────────────────────────────
#
# mackbind needs to grab the physical keyboard (read /dev/input/event*) and
# create a virtual keyboard (write /dev/uinput). Both are privileged devices.
#
# Measured on Ubuntu/Debian:
#   /dev/input/eventN   root:input  0660   ← add the user to the input group and it can be read
#   /dev/uinput         root:root   0600   ← by default **no one** can write to it
#
# So on Ubuntu, adding the user to the input group alone is not enough:
# /dev/uinput still cannot be opened, and the program exits with "cannot open
# uinput". This rule hands it to the input group.
#
# Note: other distributions may already have opened up /dev/uinput permissions
# (this repo did not hit the issue when it was first debugged on EndeavourOS);
# confirm with `ls -l /dev/uinput`. This rule is **additive** and does not
# tighten any existing config.

KERNEL=="uinput", SUBSYSTEM=="misc", GROUP="input", MODE="0660", OPTIONS+="static_node=uinput"
